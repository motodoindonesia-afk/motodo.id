# Motodo Mobile — Expo public env (client-safe only)
#
# Copy to `.env.local` (gitignored). Never commit real keys.
# Use the SAME Supabase project as Motodo Web and Ritme.
#
# Never put service_role, SUPABASE_SERVICE_ROLE_KEY, or any secret here.
# These values are bundled into the client. That is expected for the anon key.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
