# Motodo.id — Vite public env (browser-safe only)
#
# Copy this file to `.env.local` for local development.
# `.env.local` is gitignored. Never commit real keys.
#
# Frontend may only use these two variables. They are inlined into the Vite
# browser bundle at build time. That is expected for the anon/publishable key.
#
# Never put service_role, SUPABASE_SERVICE_ROLE_KEY, or any secret in this file
# or in any VITE_* variable.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key
